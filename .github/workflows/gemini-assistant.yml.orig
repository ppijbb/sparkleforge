name: AI Harness (Distributed)
on:
  push:
  pull_request:
    types: [opened, edited, synchronize, reopened, ready_for_review]
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # 1단계: 코드 변경점 리뷰 (OpenRouter / Groq 등 무료 API 직접 호출)
  code-review:
    if: >-
      github.event_name == 'pull_request' ||
      github.event_name == 'push'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 2
      
      - name: Extract Git Diff
        run: git diff HEAD~1 HEAD > diff.txt || echo "" > diff.txt
        
      - name: OpenRouter Diff Review
        env:
          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
        run: |
          if [ -z "$OPENROUTER_API_KEY" ]; then
            echo "No OpenRouter key found, skipping."
            echo "Skipped" > review_result.txt
            exit 0
          fi
          
          # jq를 사용하여 안전하게 JSON 페이로드 생성 (따옴표 이스케이프 문제 방지)
          jq -n --arg diff "$(cat diff.txt)" '{
            model: "nvidia/nemotron-3-super-120b-a12b:free", 
            messages: [
              {role: "system", content: "You are an expert code reviewer. Read the git diff and summarize key issues, bugs, or style violations briefly."},
              {role: "user", content: $diff}
            ]
          }' > payload.json
          
          # curl을 통해 직접 API 찌르기
          curl -s -X POST "https://openrouter.ai/api/v1/chat/completions" \
            -H "Authorization: Bearer $OPENROUTER_API_KEY" \
            -H "Content-Type: application/json" \
            -d @payload.json | jq -r '.choices[0].message.content' > review_result.txt
            
      - name: Cerebras Diff Review
        env:
          CEREBRAS_API_KEY: ${{ secrets.CEREBRAS_API_KEY }}
        run: |
          if [ -z "$CEREBRAS_API_KEY" ]; then
            echo "No Cerebras key found, skipping."
            echo "Skipped" > cerebras_result.txt
            exit 0
          fi
          
          jq -n --arg diff "$(cat diff.txt)" '{
            model: "zai-glm-4.7",
            messages: [
              {role: "system", content: "You are a security and architecture reviewer. Read this diff and point out critical logical or security flaws only."},
              {role: "user", content: $diff}
            ]
          }' > cerebras_payload.json
          
          curl -s -X POST "https://api.cerebras.ai/v1/chat/completions" \
            -H "Authorization: Bearer $CEREBRAS_API_KEY" \
            -H "Content-Type: application/json" \
            -d @cerebras_payload.json | jq -r '.choices[0].message.content' > cerebras_result.txt

      - name: Leave PR review summary
        if: github.event_name == 'pull_request'
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          {
            echo "## OpenCode review seed"
            echo
            echo "### OpenRouter"
            cat review_result.txt
            echo
            echo "### Cerebras"
            cat cerebras_result.txt
            echo
            echo "_This comment is used by the issue triage job to create follow-up work._"
          } > review-comment.md
          gh pr comment "${{ github.event.pull_request.number }}" \
            --repo "${{ github.repository }}" \
            --body-file review-comment.md
            
      - name: Upload Review Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: review-results
          path: |
            review_result.txt
            cerebras_result.txt

  # 2단계: 리뷰 분석 및 작업 분할/이슈 생성 (Groq / Cerebras API 직접 호출)
  issue-triage:
    needs: code-review
    if: >-
      always() &&
      needs.code-review.result == 'success' &&
      (github.event_name == 'pull_request' || github.event_name == 'push')
    runs-on: ubuntu-latest
    permissions:
      actions: write
      contents: read
      issues: write
    outputs:
      issue_url: ${{ steps.create_issue.outputs.issue_url }}
      issue_number: ${{ steps.create_issue.outputs.issue_number }}
    steps:
      - uses: actions/checkout@v4
      
      - name: Download Review Artifact
        uses: actions/download-artifact@v4
        with:
          name: review-results
          
      - name: Groq API Triage & Issue Create
        id: create_issue
        env:
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          GH_TOKEN: ${{ secrets.PAT }}
          HAS_PAT: ${{ secrets.PAT != '' }}
        run: |
          if [ "$HAS_PAT" != "true" ]; then
            echo "::error::PAT repository secret is required to create issues and dispatch opencode-auto-fix.yml as part of the automatic issue-to-PR flow."
            echo "::error::Create a PAT secret with contents, issues, pull requests, and actions write access."
            exit 1
          fi

          if [ ! -f review_result.txt ] || [ -z "$GROQ_API_KEY" ]; then
            echo "No review result or Groq key found."
            exit 0
          fi

          OPENROUTER_REVIEW=$(cat review_result.txt)
          CEREBRAS_REVIEW=$(cat cerebras_result.txt 2>/dev/null || echo '')

          if [ "$OPENROUTER_REVIEW" = "Skipped" ] && { [ -z "$CEREBRAS_REVIEW" ] || [ "$CEREBRAS_REVIEW" = "Skipped" ]; }; then
            echo "All AI reviews were skipped; not creating an issue."
            exit 0
          fi
          
          # 두 리뷰를 하나로 합침
          COMBINED_REVIEW="OpenRouter Review:\n$OPENROUTER_REVIEW\n\nCerebras Review:\n$CEREBRAS_REVIEW"
          
          # Groq 무료 티어 중 최고성능 모델을 통해 이슈 내용 생성
          jq -n --arg review "$COMBINED_REVIEW" \
            --arg system_msg "You are a senior developer talking to a teammate. Based on the review, generate a JSON object with 'should_create_issue', 'title', and 'body' keys. Set should_create_issue to true only when the review identifies a concrete correctness, security, packaging, workflow, or test failure that needs a code change. Set should_create_issue to false for skipped reviews, empty reviews, no-issue findings, praise, style-only feedback, vague suggestions, or uncertain problems. If should_create_issue is false, title and body must be empty strings. If true, the title should be a short, natural developer-style summary (e.g., 'Fix: Missing error handling in auth flow'), and the body should naturally explain what's wrong and how to fix it with code. No robotic headers. Just clear, peer-to-peer communication." \
            '{
              model: "llama-3.3-70b-versatile",
              messages: [
                {role: "system", content: $system_msg},
                {role: "user", content: $review}
              ],
              response_format: { type: "json_object" }
            }' > groq_payload.json
          
          # 만들어진 텍스트에서 제목과 본문 추출 (마크다운 백틱 제거 로직 포함)
          RAW_RESPONSE=$(curl -s -X POST "https://api.groq.com/openai/v1/chat/completions" \
            -H "Authorization: Bearer $GROQ_API_KEY" \
            -H "Content-Type: application/json" \
            -d @groq_payload.json)
          
          if echo "$RAW_RESPONSE" | jq -e '.error' >/dev/null; then
            echo "Groq API returned an error:"
            echo "$RAW_RESPONSE" | jq -r '.error.message // .error'
            exit 1
          fi

          CONTENT=$(echo "$RAW_RESPONSE" | jq -r '.choices[0].message.content // empty')
          
          if [ -n "$CONTENT" ]; then
            if ! echo "$CONTENT" | jq -e . >/dev/null; then
              echo "Groq response content was not valid JSON; skipping issue creation."
              echo "Content preview:"
              echo "$CONTENT" | head -c 1000
              echo
              exit 0
            fi
            
            SHOULD_CREATE=$(echo "$CONTENT" | jq -r '.should_create_issue // false')
            ISSUE_TITLE=$(echo "$CONTENT" | jq -r '.title // "Fix: Issue identified in review"')
            ISSUE_BODY=$(echo "$CONTENT" | jq -r '.body // empty')

            NORMALIZED_TITLE=$(echo "$ISSUE_TITLE" | tr '[:upper:]' '[:lower:]')
            if [ "$SHOULD_CREATE" != "true" ]; then
              echo "Triage decided no actionable issue should be created."
              exit 0
            fi
            if [ -z "$ISSUE_TITLE" ] || [ "$ISSUE_TITLE" = "null" ] || [ -z "$ISSUE_BODY" ]; then
              echo "Triage did not provide an actionable issue title/body."
              exit 0
            fi
            if [[ "$NORMALIZED_TITLE" == *"no issue"* ]] ||
               [[ "$NORMALIZED_TITLE" == *"nothing to fix"* ]] ||
               [[ "$NORMALIZED_TITLE" == *"no actionable"* ]] ||
               [[ "$NORMALIZED_TITLE" == *"no problem"* ]]; then
              echo "Blocked non-actionable issue title: $ISSUE_TITLE"
              exit 0
            fi
            
            # 이슈 생성
            # PAT 사용 시 해당 계정으로 생성 → issues 이벤트가 다른 workflow를 트리거 가능
            # PAT 없을 경우 github.token(bot) → issues 이벤트로 다른 workflow 트리거 불가
            # 따라서 이슈 번호를 추출해 opencode-auto-fix.yml을 직접 gh workflow run으로 트리거함
            ISSUE_URL=$(gh issue create \
              --repo "${{ github.repository }}" \
              --title "$ISSUE_TITLE" \
              --body "$ISSUE_BODY" \
              --assignee "ppijbb")
            echo "Created issue: $ISSUE_URL"
            ISSUE_NUMBER="${ISSUE_URL##*/}"
            {
              echo "issue_url=$ISSUE_URL"
              echo "issue_number=$ISSUE_NUMBER"
            } >> "$GITHUB_OUTPUT"

            # GitHub Actions bot이 생성한 이슈는 issues: opened 이벤트가
            # 다른 워크플로우를 트리거하지 않으므로 직접 workflow_dispatch로 호출
            echo "Triggering opencode-auto-fix.yml for issue #$ISSUE_NUMBER ..."
            gh workflow run opencode-auto-fix.yml \
              --repo "${{ github.repository }}" \
              --field issue_number="$ISSUE_NUMBER" \
              --field max_iterations="3"
          else
            echo "Error: AI response content is empty."
            echo "Raw response: $RAW_RESPONSE"
          fi

  merge-decision:
    needs: code-review
    if: >-
      github.event_name == 'pull_request' &&
      github.event.pull_request.base.ref == 'dev' &&
      github.event.pull_request.draft == false &&
      needs.code-review.result == 'success'
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write
      issues: write
    steps:
      - name: Download Review Artifact
        uses: actions/download-artifact@v4
        with:
          name: review-results

      - name: Decide and merge to dev
        env:
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          GH_TOKEN: ${{ secrets.PAT }}
          HAS_PAT: ${{ secrets.PAT != '' }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        run: |
          if [ "$HAS_PAT" != "true" ]; then
            echo "::error::PAT repository secret is required to auto-merge reviewed PRs into dev."
            exit 1
          fi
          if [ -z "$GROQ_API_KEY" ]; then
            echo "No Groq key found, skipping merge decision."
            exit 0
          fi

          OPENROUTER_REVIEW=$(cat review_result.txt 2>/dev/null || echo 'Missing OpenRouter review')
          CEREBRAS_REVIEW=$(cat cerebras_result.txt 2>/dev/null || echo 'Missing Cerebras review')
          PR_META=$(gh pr view "$PR_NUMBER" \
            --repo "${{ github.repository }}" \
            --json title,body,url,isDraft,mergeStateStatus,reviewDecision,headRefName,baseRefName)

          jq -n \
            --arg meta "$PR_META" \
            --arg openrouter "$OPENROUTER_REVIEW" \
            --arg cerebras "$CEREBRAS_REVIEW" \
            --arg system_msg "You are the final merge gate for a dev branch. Return a JSON object with keys should_merge and reason. Set should_merge to true only when the reviews do not identify concrete correctness, security, workflow, packaging, or test failures that require code changes. Set should_merge to false for unresolved risks, failing checks, unclear generated changes, missing review content, or any concrete issue. Keep reason concise." \
            '{
              model: "llama-3.3-70b-versatile",
              messages: [
                {role: "system", content: $system_msg},
                {role: "user", content: ("PR metadata:\n" + $meta + "\n\nOpenRouter review:\n" + $openrouter + "\n\nCerebras review:\n" + $cerebras)}
              ],
              response_format: { type: "json_object" }
            }' > merge_decision_payload.json

          RAW_RESPONSE=$(curl -s -X POST "https://api.groq.com/openai/v1/chat/completions" \
            -H "Authorization: Bearer $GROQ_API_KEY" \
            -H "Content-Type: application/json" \
            -d @merge_decision_payload.json)

          if echo "$RAW_RESPONSE" | jq -e '.error' >/dev/null; then
            echo "Groq API returned an error:"
            echo "$RAW_RESPONSE" | jq -r '.error.message // .error'
            exit 1
          fi

          CONTENT=$(echo "$RAW_RESPONSE" | jq -r '.choices[0].message.content // empty')
          if ! echo "$CONTENT" | jq -e . >/dev/null; then
            echo "Merge decision content was not valid JSON; skipping auto-merge."
            echo "$CONTENT" | head -c 1000
            echo
            exit 0
          fi

          SHOULD_MERGE=$(echo "$CONTENT" | jq -r '.should_merge // false')
          REASON=$(echo "$CONTENT" | jq -r '.reason // "No reason provided."')
          MERGE_STATE=$(echo "$PR_META" | jq -r '.mergeStateStatus // "UNKNOWN"')

          {
            echo "## Auto Merge Decision"
            echo
            echo "**Decision:** $SHOULD_MERGE"
            echo
            echo "**Merge state:** $MERGE_STATE"
            echo
            echo "**Reason:** $REASON"
          } > merge-decision-comment.md
          gh pr comment "$PR_NUMBER" \
            --repo "${{ github.repository }}" \
            --body-file merge-decision-comment.md

          if [ "$SHOULD_MERGE" != "true" ]; then
            echo "Merge decision blocked auto-merge: $REASON"
            exit 0
          fi

          if [ "$MERGE_STATE" = "DIRTY" ] || [ "$MERGE_STATE" = "BLOCKED" ] || [ "$MERGE_STATE" = "DRAFT" ]; then
            echo "PR is not currently mergeable: $MERGE_STATE"
            exit 0
          fi

          if [ "$MERGE_STATE" = "CLEAN" ]; then
            gh pr merge "$PR_NUMBER" \
              --repo "${{ github.repository }}" \
              --squash \
              --delete-branch
          else
            gh pr merge "$PR_NUMBER" \
              --repo "${{ github.repository }}" \
              --squash \
              --auto \
              --delete-branch
          fi
